# Cairn fleet secrets — `cp infra/secrets.env.example infra/secrets.env` and fill in.
# The real infra/secrets.env is GITIGNORED and must never be committed.
# launch.py auto-loads it and injects these into every fleet node at boot (via SkyPilot env),
# so the HF token transfers to the target machines automatically — you never hand-copy it to a node.

# HuggingFace token — pulls model weights (gpt-oss, GLM-5.2, GPT-NeoX-20B, Llama-3.1-8B).
# A read-scoped token is enough. For gated models (Llama-3.1) accept the license on HF first.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Wire pre-shared key for the ChaCha20 block-to-block transport. Generate once:
#   openssl rand -hex 32
SHARD_PSK=

# CF control-plane URL the nodes register with (from your wrangler deploy).
CAIRN_CONTROL_URL=https://<your-worker>.workers.dev
