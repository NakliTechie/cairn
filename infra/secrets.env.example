# Cairn fleet secrets — `cp infra/secrets.env.example infra/secrets.env` and fill in.
# The real infra/secrets.env is GITIGNORED and must never be committed.
# Load before launching:  set -a; source infra/secrets.env; set +a   (bringup.sh does this for you).
# launch.py / bringup.sh inject these into every fleet node at boot via SkyPilot env — you never
# hand-copy a secret to a node.

# ── Required ───────────────────────────────────────────────────────────────────
# HuggingFace token — pulls the model weights (DeepSeek-V4-Flash FP8). A read-scoped token is enough.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Wire pre-shared key for the ChaCha20 block-to-block transport. Generate once:  openssl rand -hex 32
SHARD_PSK=

# ── Weight / image cache (recommended — avoids a ~294 GB HF pull + Docker Hub pull per box) ─────────
# Read-only key that pulls weights from the in-region S3 cache (skypilot-cairn-weights-<region>) if present;
# absent → falls back to a direct HF download.
CAIRN_S3_CACHE_ACCESS_KEY_ID=
CAIRN_S3_CACHE_SECRET_ACCESS_KEY=
# Write-capable key for the in-region ECR image mirror (and to populate the S3 cache). Absent → Docker Hub.
CAIRN_S3_WRITE_ACCESS_KEY_ID=
CAIRN_S3_WRITE_SECRET_ACCESS_KEY=

# ── Self-replenish (optional — auto-launch a replacement spare when one is consumed) ────────────────
# Launch key the on-box watcher uses to `sky launch` a replacement spare cluster. Scope it least-privilege
# (see infra/aws/cairn-spare-launch-policy.json). Only needed with CAIRN_SELF_REPLENISH=1.
CAIRN_LAUNCH_AWS_ACCESS_KEY_ID=
CAIRN_LAUNCH_AWS_SECRET_ACCESS_KEY=

# ── Spot-reclaim alerts (optional) ─────────────────────────────────────────────────────────────────
# ntfy topic URL for preemption/recovery notifications; CallMeBot for WhatsApp. All optional.
CAIRN_ALERT_WEBHOOK=
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
