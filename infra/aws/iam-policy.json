{
  "_comment": "Least-privilege policy for SkyPilot to run the Cairn spot fleet, on the 'cairn-skypilot' IAM user. HARDENED + SkyPilot-aligned (2026-06-21, after `sky check`): the H5/H6 region-lock now applies ONLY to MUTATING actions — provisioning is locked to [eu-south-2, ap-northeast-2] and destructive instance actions are additionally gated on the 'cairn=true' tag. Read-only ec2:Describe*/Get* is allowed in ANY region because SkyPilot must enumerate regions/AZs/capacity to launch (read-only, no cost, no resource creation → low blast radius). S3 is scoped to skypilot-*/sky-* buckets (+ global ListAllMyBuckets, a names-only list SkyPilot's check requires). iam:CreateServiceLinkedRole is limited to spot.amazonaws.com. Re-validate with `sky check aws` + a live launch; if an action still fails, add THAT action specifically — never Resource:*. [test: live sky check + launch]",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDescribeAnyRegion",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:Get*"],
      "Resource": "*"
    },
    {
      "Sid": "ProvisionInRegion",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:CreatePlacementGroup",
        "ec2:DeletePlacementGroup",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:ModifyInstanceAttribute",
        "ec2:CreateKeyPair",
        "ec2:DeleteKeyPair",
        "ec2:RequestSpotInstances",
        "ec2:CancelSpotInstanceRequests"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": ["eu-south-2", "ap-northeast-2"] } }
    },
    {
      "Sid": "MutateOnlyCairnTaggedInstances",
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances", "ec2:StopInstances", "ec2:StartInstances"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ["eu-south-2", "ap-northeast-2"],
          "ec2:ResourceTag/cairn": "true"
        }
      }
    },
    {
      "Sid": "InstanceProfileScopedToSkyPilot",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:CreateRole",
        "iam:CreateInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:ListInstanceProfiles",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::*:role/skypilot-*",
        "arn:aws:iam::*:instance-profile/skypilot-*"
      ]
    },
    {
      "Sid": "PassOnlySkyPilotRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/skypilot-*",
      "Condition": { "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" } }
    },
    {
      "Sid": "SpotServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": { "StringEquals": { "iam:AWSServiceName": "spot.amazonaws.com" } }
    },
    {
      "Sid": "SkyPilotS3Buckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:PutBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::skypilot-*",
        "arn:aws:s3:::skypilot-*/*",
        "arn:aws:s3:::sky-*",
        "arn:aws:s3:::sky-*/*"
      ]
    },
    {
      "Sid": "S3ListAllBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    }
  ]
}
